<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<listeners>
		<listener class-name="Mashruq.TestComponent.ExtentReportManager" />
	</listeners>
	
	<test thread-count="5" name="Linux-Chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="os" value="linux" />
		<classes>
			<class name="Mashruq.Test.LoginTest" />
			<class name="Mashruq.Test.StandAloneTest" />
		</classes>
	</test> <!--
	Test -->

	<test thread-count="5" name="Linux-firefox">
		<parameter name="browser" value="firefox" />
		<parameter name="os" value="linux" />
		<classes>
			<class name="Mashruq.Test.LoginTest" />
			<class name="Mashruq.Test.StandAloneTest" />
		</classes>
	</test>

</suite> <!--
Suite -->
